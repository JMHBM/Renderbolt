def ffmpeg_env_for(device: str) -> dict[str, str]:
    """Pin libva to this DRM node.

    LM Studio's AMD path works because it picks a Vulkan/ROCm device and
    does not let the compositor decide. Same idea here: drop DISPLAY /
    WAYLAND_DISPLAY so FFmpeg talks DRM, not the iGPU attached to the session.
    """
    env = os.environ.copy()
    env.pop("DISPLAY", None)
    env.pop("WAYLAND_DISPLAY", None)
    env["LIBVA_DRM_DEVICE"] = device
    prime = dri_pci_prime(device)
    if prime:
        env["DRI_PRIME"] = prime
    vendor = dri_vendor(device)
    if vendor == PCI_AMD:
        env["LIBVA_DRIVER_NAME"] = "radeonsi"
    elif vendor == PCI_NVIDIA:
        env.setdefault("LIBVA_DRIVER_NAME", "nvidia")
    return env


def vainfo_encode_codecs(device: str, env: dict[str, str]) -> set[str]:
    """Return {'h264', 'hevc', ...} advertised as EncSlice, or empty if unknown."""
    if not which("vainfo"):
        return set()
    try:
        proc = subprocess.run(
            ["vainfo", "--display", "drm", "--device", device],
            capture_output=True,
            text=True,
            timeout=6,
            env=env,
        )
    except (OSError, subprocess.TimeoutExpired):
        return set()
    text = (proc.stdout or "") + "\n" + (proc.stderr or "")
    found: set[str] = set()
    current = ""
    for line in text.splitlines():
        s = line.strip()
        if s.startswith("VAProfile"):
            current = s
        if "EncSlice" in s or "VAEntrypointEncSlice" in s:
            blob = current + " " + s
            if "H264" in blob:
                found.add("h264")
            if "HEVC" in blob or "H265" in blob:
                found.add("hevc")
            if "AV1" in blob:
                found.add("av1")
    return found


def probe_vaapi(device: str, encoder: str, env: dict[str, str]) -> tuple[bool, str]:
    """Confirm a short hardware encode actually completes on this node.

    The export path is raw RGB24 on stdin, not lavfi. Probe that pipe or we
    will 'succeed' here and still fall back to CPU on Generate.
    """
    extra = "128"
    bin_ = ffmpeg_bin() or "ffmpeg"
    w, h, nframes = 1920, 1080, 4
    raw_cmd = [
        bin_,
        "-hide_banner",
        "-nostdin",
        "-v",
        "error",
        "-init_hw_device",
        f"vaapi=va:{device}",
        "-filter_hw_device",
        "va",
        "-f",
        "rawvideo",
        "-pix_fmt",
        "rgb24",
        "-s",
        f"{w}x{h}",
        "-r",
        "30",
        "-i",
        "-",
        "-vf",
        f"format=nv12,hwupload=extra_hw_frames={extra}",
        "-c:v",
        encoder,
        "-qp",
        "18",
        "-frames:v",
        str(nframes),
        "-f",
        "null",
        "-",
    ]
    payload = bytes(w * h * 3) * nframes
    try:
        proc = subprocess.run(
            raw_cmd,
            input=payload,
            capture_output=True,
            timeout=20,
            env=env,
        )
        log = (proc.stderr or proc.stdout or b"").decode("utf-8", "replace").strip()
        if proc.returncode == 0:
            return True, log
        raw_fail = log
    except (OSError, subprocess.TimeoutExpired) as exc:
        raw_fail = str(exc)

    # Older lavfi recipe — diagnostic only, not sufficient to select the GPU.
    lavfi = [
        bin_,
        "-hide_banner",
        "-nostdin",
        "-v",
        "error",
        "-init_hw_device",
        f"vaapi=va:{device}",
        "-filter_hw_device",
        "va",
        "-f",
        "lavfi",
        "-i",
        "color=c=black:s=640x360:d=0.35:r=30",
        "-vf",
        f"format=nv12,hwupload=extra_hw_frames={extra}",
        "-c:v",
        encoder,
        "-f",
        "null",
        "-",
    ]
    try:
        proc = subprocess.run(lavfi, capture_output=True, text=True, timeout=12, env=env)
        lavfi_log = (proc.stderr or proc.stdout or "").strip()
        lavfi_ok = proc.returncode == 0
    except (OSError, subprocess.TimeoutExpired) as exc:
        lavfi_log = str(exc)
        lavfi_ok = False
    return False, f"raw rgb24 1080p: {raw_fail or 'fail'}\nlavfi: {'OK' if lavfi_ok else lavfi_log}"


