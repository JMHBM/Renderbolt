def merge_look(*parts: dict) -> dict:
    look = default_look()
    place = dict(look["place"])
    for part in parts:
        if not part:
            continue
        nested = part.get("place") or {}
        place.update(nested)
        look.update({k: v for k, v in part.items() if k != "place"})
    look["place"] = place
    theme = look.get("theme")
    if theme in THEMES and not any("base" in p for p in parts if p):
        look["base"], look["tip"] = THEMES[theme]
    return look


