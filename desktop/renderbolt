    def _on_key(self, e) -> str | None:
        cls = e.widget.winfo_class()
        if cls in ("Entry", "TEntry", "Text", "TCombobox"):
            return None
        if e.keysym in ("space", "Space"):
            self.toggle_play()
            return "break"
        if e.char in ("g", "G"):
            self.generate()
            return "break"
        if e.char in ("r", "R"):
            self.shuffle_look()
            return "break"
        if e.char in ("s", "S"):
            self.snapshot()
            return "break"
        if e.keysym == "Left":
            self.seek_to(self._t0 - 2)
            return "break"
        if e.keysym == "Right":
            self.seek_to(self._t0 + 2)
            return "break"
        if e.keysym == "Home":
            self.seek_to(0)
            return "break"
        return None

    def _try_dnd(self) -> None:
        try:
            self.tk.call("package", "require", "tkdnd")
        except tk.TclError:
            return
        try:
            self.tk.call("tkdnd::drop_target", "register", self._w, "DND_Files")
            self.bind("<<Drop>>", self._on_drop)
        except tk.TclError:
            return

    def _on_drop(self, e) -> None:
        data = getattr(e, "data", "") or ""
        paths = [p.strip("{}") for p in data.split() if p]
        for path in paths:
            ext = os.path.splitext(path)[1].lower()
            if ext in {".mp3", ".wav", ".flac", ".ogg", ".m4a", ".aac"}:
                self._load_audio(path)
            elif ext in {".jpg", ".jpeg", ".png", ".webp"}:
                self.image_path = path
                self.image_var.set(os.path.basename(path))
                self._load_cover(path)

    def seek_to(self, t: float) -> None:
        self._t0 = max(0.0, min(self._duration - 0.01, float(t)))
        self._clock = time.perf_counter() - self._t0
        if self._playing:
            self._start_audio()

    def _seek_click(self, e) -> None:
        w = max(1, e.widget.winfo_width())
        self.seek_to((e.x / w) * self._duration)

    def _grade(self) -> dict:
        return {
            "glow": float(self.glow_var.get()),
            "vignette": float(self.vignette_var.get()),
            "grain": float(self.grain_var.get()),
            "title_scale": float(self.title_scale.get()),
            "fade_in": float(self.fade_in.get()),
            "fade_out": float(self.fade_out.get()),
            "title_pos": self.title_pos.get(),
            "pulse_hue": float(self.pulse_hue.get()),
        }

    def pick_logo(self) -> None:
        path = filedialog.askopenfilename(
            title="Watermark logo",
            filetypes=[("Images", "*.png *.webp *.jpg *.jpeg"), ("All", "*.*")],
        )
        if not path:
            return
        self.logo_path = path
        self.logo_im = Image.open(path).convert("RGBA")
        self.status.set(f"Logo {os.path.basename(path)}")

    def shuffle_look(self) -> None:
        import random
        self.mode_var.set(random.choice(["2D", "3D"]))
        self.style_var.set(random.choice(list(STYLES)))
        name = random.choice(list(THEMES))
        self.theme_var.set(name)
        self.bounce_var.set(random.choice(list(BOUNCE)))
        self.vis_x.set(round(random.uniform(-0.25, 0.25), 2))
        self.vis_y.set(round(random.uniform(-0.2, 0.2), 2))
        self.vis_rot.set(random.choice([0, 0, 0, 12, 348, 180]))
        self.vis_sx.set(round(random.uniform(0.85, 1.25), 2))
        self.vis_sy.set(round(random.uniform(0.85, 1.2), 2))
        self.glow_var.set(round(random.uniform(0.2, 0.7), 2))
        self.grain_var.set(round(random.uniform(0.04, 0.18), 2))
        self.pulse_hue.set(random.choice([0, 0, 24, 48, 90]))
        self.aspect_var.set(random.choice(["16:9", "16:9", "9:16", "1:1"]))
        self.status.set("Shuffled look")

    def dump_look(self) -> dict:
        return {
            "mode": self.mode_var.get(),
            "style": self.style_var.get(),
            "theme": self.theme_var.get(),
            "base": self.base_color.get(),
            "tip": self.tip_color.get(),
            "bounce": self.bounce_var.get(),
            "tilt": self.tilt_var.get(),
            "alpha": self.alpha_var.get(),
            "place": self._place(),
            "sens": self.sens_var.get(),
            "glow": self.glow_var.get(),
            "vignette": self.vignette_var.get(),
            "grain": self.grain_var.get(),
            "title_scale": self.title_scale.get(),
            "show_titles": self.show_titles.get(),
            "show_progress": self.show_progress.get(),
            "aspect": self.aspect_var.get(),
            "res": self.res_var.get(),
            "fps": self.fps_var.get(),
            "fade_in": self.fade_in.get(),
            "fade_out": self.fade_out.get(),
            "title_pos": self.title_pos.get(),
            "pulse_hue": self.pulse_hue.get(),
        }

    def apply_look(self, data: dict) -> None:
        data = merge_look(data)
        self.mode_var.set(data.get("mode", "3D"))
        self.style_var.set(data.get("style", "Waveform"))
        if data.get("theme") in THEMES:
            self.theme_var.set(data["theme"])
        self.base_color.set(data.get("base", THEMES["Ice"][0]))
        self.tip_color.set(data.get("tip", THEMES["Ice"][1]))
        if data.get("bounce") in BOUNCE:
            self.bounce_var.set(data["bounce"])
        self.tilt_var.set(float(data.get("tilt", 42)))
        self.alpha_var.set(float(data.get("alpha", 0.78)))
        place = data.get("place") or {}
        self.vis_x.set(float(place.get("x", 0)))
        self.vis_y.set(float(place.get("y", 0)))
        self.vis_rot.set(float(place.get("rot", 0)))
        self.vis_sx.set(float(place.get("sx", 1)))
        self.vis_sy.set(float(place.get("sy", 1)))
        self.mirror.set(bool(place.get("mirror", False)))
        self.sens_var.set(float(data.get("sens", 1)))
        self.glow_var.set(float(data.get("glow", 0.4)))
        self.vignette_var.set(float(data.get("vignette", 0.55)))
        self.grain_var.set(float(data.get("grain", 0.1)))
        self.title_scale.set(float(data.get("title_scale", 1)))
        self.show_titles.set(bool(data.get("show_titles", True)))
        self.show_progress.set(bool(data.get("show_progress", True)))
        if data.get("aspect") in ASPECTS:
            self.aspect_var.set(data["aspect"])
        if data.get("res") in RESOLUTIONS:
            self.res_var.set(data["res"])
        if str(data.get("fps")) in ("24", "30", "60"):
            self.fps_var.set(str(data["fps"]))
        self.fade_in.set(float(data.get("fade_in", 0.6)))
        self.fade_out.set(float(data.get("fade_out", 1.2)))
        if data.get("title_pos") in ("Top", "Bottom"):
            self.title_pos.set(data["title_pos"])
        self.pulse_hue.set(float(data.get("pulse_hue", 0)))

    def apply_starter(self, name: str) -> None:
        look = STARTER_LOOKS.get(name)
        if not look:
            return
        self.apply_look(look)
        self.status.set(f"Look · {name}")

    def save_look(self) -> None:
        path = filedialog.asksaveasfilename(
            title="Save look",
            defaultextension=".json",
            filetypes=[("Renderbolt look", "*.json")],
            initialfile="renderbolt-look.json",
        )
        if not path:
            return
        Path(path).write_text(json.dumps(self.dump_look(), indent=2))
        self.status.set(f"Saved look {os.path.basename(path)}")

    def load_look(self) -> None:
        path = filedialog.askopenfilename(title="Load look", filetypes=[("Renderbolt look", "*.json"), ("All", "*.*")])
        if not path:
            return
        self.apply_look(json.loads(Path(path).read_text()))
        self.status.set(f"Loaded {os.path.basename(path)}")

    def snapshot(self) -> None:
        path = filedialog.asksaveasfilename(
            title="Save frame",
            defaultextension=".png",
            filetypes=[("PNG image", "*.png")],
            initialfile=f"{self.song.get() or 'renderbolt'}-frame.png",
            initialdir=self._export_dir or None,
        )
        if not path:
            return
        try:
            self._render_preview()
            frame = self._current_frame(export=True)
            frame.save(path)
            self._export_dir = str(Path(path).parent)
            self.status.set(f"Saved frame {os.path.basename(path)}")
        except Exception as exc:
            messagebox.showerror(APP_NAME, str(exc))

    def _current_frame(self, export: bool = False) -> Image.Image:
        if self._analyzer is None:
            raise RuntimeError("No audio to frame.")
        g = self._grade()
        dt = 1 / max(1, int(self.fps_var.get() or 30))
        analysis = self._analyzer.at(self._t0, dt, float(self.sens_var.get()))
        theme = (*self._theme_pair(), self._theme_pair()[1])
        size = frame_wh(self.aspect_var.get(), self.res_var.get()) if export else self._preview_wh()
        cover = self.cover or Image.new("RGB", size, (12, 12, 16))
        return render_frame(
            cover,
            analysis,
            self._t0,
            self._duration,
            self.style_var.get(),
            theme,
            self.song.get(),
            self.artist.get(),
            self.album.get(),
            BOUNCE.get(self.bounce_var.get(), 1.0),
            self.show_titles.get(),
            [1.12],
            None,
            float(self.tilt_var.get()),
            float(self.alpha_var.get()),
            size,
            self.mode_var.get(),
            self._place(),
            self.show_progress.get(),
            g["glow"],
            g["vignette"],
            g["grain"],
            g["title_scale"],
            self.logo_im,
            g["fade_in"],
            g["fade_out"],
            g["title_pos"],
            g["pulse_hue"],
        )

    def toggle_play(self) -> None:
        if self._playing:
            self._playing = False
            self.play_btn.configure(text="▶")
            self._stop_audio()
            return
        self._playing = True
        self._clock = time.perf_counter() - self._t0
        self.play_btn.configure(text="⏸")
        self._start_audio()

    def _start_audio(self) -> None:
        self._stop_audio()
        path = self.audio_path
        if not path or not which("ffplay"):
            return
        self._player = subprocess.Popen(
            ["ffplay", "-nodisp", "-autoexit", "-ss", f"{self._t0:.2f}", "-loglevel", "quiet", path],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        )

    def _stop_audio(self) -> None:
        if self._player is not None:
            self._player.terminate()
            try:
                self._player.wait(timeout=0.4)
            except Exception:
                self._player.kill()
            self._player = None

    def _tick(self) -> None:
        dt = 1 / 24
        if self._playing:
            self._t0 = time.perf_counter() - self._clock
            if self._t0 >= self._duration:
                if self.loop_preview.get():
                    self._t0 = 0.0
                    self._clock = time.perf_counter()
                    self._start_audio()
                else:
                    self._t0 = 0.0
                    self._playing = False
                    self.play_btn.configure(text="▶")
                    self._stop_audio()
        self._render_preview()
        p = 0 if self._duration <= 0 else 100 * (self._t0 / self._duration)
        self.pbar["value"] = p
        self.time_var.set(f"{int(self._t0 // 60)}:{int(self._t0 % 60):02d} / {int(self._duration // 60)}:{int(self._duration % 60):02d}")
        self._preview_job = self.after(int(dt * 1000), self._tick)

    def _render_preview(self) -> None:
        if self.cover is None or self._analyzer is None:
            return
        try:
            analysis = self._analyzer.at(self._t0, 1 / 24, float(self.sens_var.get()))
            theme = self._theme_pair()
            bounce = BOUNCE.get(self.bounce_var.get(), 1.0)
            g = self._grade()
            frame = render_frame(
                self.cover,
                analysis,
                self._t0,
                self._duration,
                self.style_var.get(),
                theme,
                self.song.get(),
                self.artist.get(),
                self.album.get(),
                bounce,
                self.show_titles.get(),
                self._zoom_preview,
                None,
                float(self.tilt_var.get()),
                float(self.alpha_var.get()),
                self._preview_wh(),
                self.mode_var.get(),
                self._place(),
                self.show_progress.get(),
                g["glow"],
                g["vignette"],
                g["grain"],
                g["title_scale"],
                self.logo_im,
                g["fade_in"],
                g["fade_out"],
                g["title_pos"],
                g["pulse_hue"],
            )
            self.preview_imgtk = ImageTk.PhotoImage(frame)
            self.preview.configure(image=self.preview_imgtk)
        except Exception:
            pass

    def _preview_wh(self) -> tuple[int, int]:
        pw = max(320, int(self.preview.winfo_width() or 640))
        ph = max(180, int(self.preview.winfo_height() or 360))
        ar = ASPECTS.get(self.aspect_var.get(), (16, 9))
        if pw / ph > ar[0] / ar[1]:
            pw = int(ph * ar[0] / ar[1])
        else:
            ph = int(pw * ar[1] / ar[0])
        cap = 720 if ar[1] > ar[0] else 960
        scale = min(1.0, cap / max(pw, ph, 1))
        return max(160, int(pw * scale)), max(160, int(ph * scale))

    def _theme_pair(self) -> tuple[str, str]:
        return (self.base_color.get() or "#156a96", self.tip_color.get() or "#b8ecff")

    def _place(self) -> dict:
        return {
            "x": float(self.vis_x.get()),
            "y": float(self.vis_y.get()),
            "rot": float(self.vis_rot.get()),
            "sx": float(self.vis_sx.get()),
            "sy": float(self.vis_sy.get()),
            "mirror": bool(self.mirror.get()),
        }

    def pick_audio(self) -> None:
        path = filedialog.askopenfilename(
            title="Audio file",
            filetypes=[("Audio", "*.mp3 *.wav *.flac *.ogg *.m4a *.aac"), ("All", "*.*")],
            initialdir=self._audio_dir or None,
        )
        if not path:
            return
        self._audio_dir = str(Path(path).parent)
        self._load_audio(path)

    def _load_audio(self, path: str) -> None:
        self.audio_path = path
        self.audio_var.set(os.path.basename(path))
        self.status.set("Decoding audio…")
        self.update_idletasks()
        try:
            samples, sr = decode_audio(path)
            self._analyzer = Analyzer(samples, sr)
            self._duration = samples.size / sr
            self._using_demo = False
            self._t0 = 0.0
            self.status.set("Ready · preview is live")
        except Exception as exc:
            messagebox.showerror(APP_NAME, str(exc))
            self.status.set("Could not decode audio")

    def pick_image(self) -> None:
        path = filedialog.askopenfilename(
            title="Background image",
            filetypes=[("Images", "*.jpg *.jpeg *.png *.webp"), ("All", "*.*")],
            initialdir=self._image_dir or None,
        )
        if not path:
            return
        self._image_dir = str(Path(path).parent)
        self.image_path = path
        self.image_var.set(os.path.basename(path))
        self._load_cover(path)

    def _load_cover(self, path: str | None) -> None:
        if not path or not os.path.isfile(path):
            self.cover = Image.new("RGB", (W, H), (12, 12, 16))
        else:
            self.cover = Image.open(path).convert("RGB")
        self._zoom_preview = [1.12]
        self._render_preview()

    def generate(self) -> None:
        if not self.audio_path:
            messagebox.showinfo(APP_NAME, "Choose an audio file first.")
            return
        dest = filedialog.asksaveasfilename(
            title="Save MP4",
            defaultextension=".mp4",
            filetypes=[("MP4 video", "*.mp4")],
            initialfile=f"{self.song.get() or 'renderbolt'}.mp4",
            initialdir=self._export_dir or None,
        )
        if not dest:
            return
        self._export_dir = str(Path(dest).parent)
        was_playing = self._playing
        self._playing = False
        self._stop_audio()
        if self._preview_job:
            self.after_cancel(self._preview_job)
            self._preview_job = None

        def progress(msg: str, pct: float) -> None:
            self.status.set(msg)
            if pct:
                self.pbar["value"] = pct
            self.update_idletasks()

        try:
            cover = self.cover or Image.new("RGB", (W, H), (12, 12, 16))
            label = run_export(
                self.audio_path,
                dest,
                cover,
                self.dump_look(),
                self.song.get(),
                self.artist.get(),
                self.album.get(),
                self.logo_im,
                progress,
            )
            self.pbar["value"] = 100
            self.status.set(f"Saved {dest} · {label}")
            self._persist()
            messagebox.showinfo(APP_NAME, f"Saved {dest}\nEncoder: {label}")
        except Exception as exc:
            messagebox.showerror(APP_NAME, str(exc))
            self.status.set("Generate failed")
        finally:
            self._playing = False
            self.play_btn.configure(text="▶")
            if was_playing:
                pass
            self.after(40, self._tick)


def parse_args(argv: list[str] | None = None) -> argparse.Namespace:
    p = argparse.ArgumentParser(add_help=False, prog="renderbolt")
    p.add_argument("command", nargs="?", default="")
    p.add_argument("--audio")
    p.add_argument("--cover")
    p.add_argument("--out")
    p.add_argument("--look")
    p.add_argument("--preset")
    p.add_argument("--mode")
    p.add_argument("--style")
    p.add_argument("--theme")
    p.add_argument("--title", default="")
    p.add_argument("--artist", default="")
    p.add_argument("--album", default="")
    p.add_argument("--aspect")
    p.add_argument("--res")
    p.add_argument("--fps")
    p.add_argument("--version", action="store_true")
    p.add_argument("-h", "--help", action="store_true")
    return p.parse_args(argv)


def cli_render(args: argparse.Namespace) -> int:
    if not args.audio or not args.out:
        print("render needs --audio and --out", file=sys.stderr)
        return 2
    look = default_look()
    if args.preset:
        key = next((k for k in STARTER_LOOKS if k.lower() == args.preset.lower()), None)
        if not key:
            print(f"unknown preset {args.preset!r}", file=sys.stderr)
            print("presets:", ", ".join(STARTER_LOOKS), file=sys.stderr)
            return 2
        look = merge_look(look, STARTER_LOOKS[key])
    if args.look:
        look = merge_look(look, json.loads(Path(args.look).read_text()))
    overrides = {}
    if args.mode:
        overrides["mode"] = args.mode
    if args.style:
        overrides["style"] = args.style
    if args.theme:
        overrides["theme"] = args.theme
        if args.theme in THEMES:
            overrides["base"], overrides["tip"] = THEMES[args.theme]
    if args.aspect:
        overrides["aspect"] = args.aspect
    if args.res:
        overrides["res"] = args.res
    if args.fps:
        overrides["fps"] = str(args.fps)
    look = merge_look(look, overrides)
    cover_path = args.cover or (DEFAULT_COVER if os.path.isfile(DEFAULT_COVER) else None)
    cover = Image.open(cover_path).convert("RGB") if cover_path else Image.new("RGB", (W, H), (12, 12, 16))

    def progress(msg: str, pct: float) -> None:
        if pct:
            print(f"{msg}  {pct:5.1f}%", flush=True)
        else:
            print(msg, flush=True)

    label = run_export(
        args.audio,
        args.out,
        cover,
        look,
        args.title,
        args.artist,
        args.album,
        None,
        progress,
    )
    print(f"saved {args.out} · {label}")
    return 0


def main() -> None:
    args = parse_args()
    if args.help:
        print(HELP_TEXT)
        return
    if args.version and not args.out:
        print(f"{APP_NAME} {VERSION} · {AUTHOR} · {LICENSE}")
        return
    if args.command == "render" or args.out:
        raise SystemExit(cli_render(args))
    app = App()
    app.mainloop()


if __name__ == "__main__":
    main()
