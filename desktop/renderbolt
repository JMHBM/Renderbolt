    p = 0 if duration <= 0 else clamp(t / duration)
    if show_progress:
        draw.rounded_rectangle([pad, y, pad + tw, y + 4], radius=2, fill=(244, 240, 234, 40))
        draw.rounded_rectangle([pad, y, pad + max(4, int(tw * p)), y + 4], radius=2, fill=(*primary, 255))
        hx = pad + int(tw * p)
        draw.ellipse([hx - 5, y - 3, hx + 5, y + 7], fill=(244, 240, 234, 255))
    if not show_titles:
        return
    scale = (h / 1080) * max(0.5, min(1.8, title_scale))
    title_font = font(max(16, int(44 * scale)), bold=True)
    meta_font = font(max(11, int(20 * scale)), bold=False)
    song_s = (song or "").strip()
    meta = "  ·  ".join(x.upper() for x in (artist, album) if x.strip())
    top = title_pos.lower().startswith("top")
    ty = int(48 * scale + (h * 0.04 if top else 0)) if top else int(h - 130 * scale)
    my = ty + int(52 * scale)
    if song_s:
        draw.rectangle([pad, ty + int(8 * scale), pad + 6, ty + int(52 * scale)], fill=(*primary, 230))
        draw.text((pad + 22 * scale, ty), song_s.upper()[:48], font=title_font, fill=(244, 240, 234, 255))
        if meta:
            draw.text((pad + 22 * scale, my), meta[:64], font=meta_font, fill=(244, 240, 234, 160))
    tc = f"{int(t // 60)}:{int(t % 60):02d}  /  {int(duration // 60)}:{int(duration % 60):02d}"
    draw.text((w - pad - 160 * scale, y - 28), tc, font=meta_font, fill=(244, 240, 234, 140))


def render_frame(
    cover: Image.Image,
    analysis: dict,
    t: float,
    duration: float,
    style: str,
    theme: tuple[str, str, str],
    song: str,
    artist: str,
    album: str,
    bounce: float,
    show_titles: bool,
    zoom_state: list[float],
    engine: object | None = None,
    tilt: float = 42.0,
    vis_alpha: float = 0.72,
    size: tuple[int, int] | None = None,
    mode: str = "3D",
    place: dict | None = None,
    show_progress: bool = True,
    glow: float = 0.35,
    vignette: float = 0.55,
    grain: float = 0.1,
    title_scale: float = 1.0,
    logo: Image.Image | None = None,
    fade_in: float = 0.0,
    fade_out: float = 0.0,
    title_pos: str = "Bottom",
    pulse_hue: float = 0.0,
) -> Image.Image:
    pulse = float(analysis.get("pulse") or 0)
    if pulse_hue > 1:
        deg = pulse_hue * (0.25 + pulse)
        theme = (hue_shift(theme[0], deg), hue_shift(theme[1], deg), theme[2] if len(theme) > 2 else theme[1])
    primary, secondary = hex_rgb(theme[0]), hex_rgb(theme[1] if len(theme) > 1 else theme[0])
    out_w, out_h = size or (W, H)
    place = place or {}
    if engine is not None and size is None and mode == "3D":
        rgb = engine.render_rgb(analysis, style, theme, bounce, zoom_state, tilt, vis_alpha, t, place)
        ow, oh = getattr(engine, "w", W), getattr(engine, "h", H)
        img = Image.frombytes("RGB", (ow, oh), rgb).convert("RGBA")
        img = apply_grade(img, vignette, grain, t)
        draw_chrome(img, t, duration, primary, song, artist, album, show_titles, show_progress, title_scale, title_pos)
        draw_logo(img, logo)
        img = img.convert("RGB")
        g = fade_gain(t, duration, fade_in, fade_out)
        if g < 0.999:
            img = Image.blend(Image.new("RGB", img.size, (10, 10, 11)), img, g)
        return img

    pulse = analysis["pulse"] * bounce
    target = 1.1 + pulse * 0.16 + analysis["bass"] * 0.04
    zoom_state[0] = lerp(zoom_state[0], target, 0.28)
    img = Image.new("RGBA", (out_w, out_h), (10, 10, 11, 255))
    cover_draw(img, cover.convert("RGBA"), zoom_state[0], pulse, out_w, out_h)
    try:
        from preview3d import draw_visualizer
    except ImportError:
        from desktop.preview3d import draw_visualizer  # type: ignore
    draw_visualizer(img, analysis, style, theme, tilt, vis_alpha, t, mode, place, glow)
    img = apply_grade(img, vignette, grain, t)
    draw_chrome(img, t, duration, primary, song, artist, album, show_titles, show_progress, title_scale, title_pos)
    draw_logo(img, logo)
    img = img.convert("RGB")
    g = fade_gain(t, duration, fade_in, fade_out)
    if g < 0.999:
        img = Image.blend(Image.new("RGB", img.size, (10, 10, 11)), img, g)
    return img


def theme_pair_from_look(look: dict) -> tuple[str, str, str]:
    theme = look.get("theme") or "Ice"
    preset = THEMES.get(theme, THEMES["Ice"])
    base = look.get("base") or preset[0]
    tip = look.get("tip") or preset[1]
    return (str(base), str(tip), str(tip))


def run_export(
    audio_path: str,
    dest: str,
    cover: Image.Image,
    look: dict,
    song: str = "",
    artist: str = "",
    album: str = "",
    logo: Image.Image | None = None,
    progress=None,
) -> str:
    """Encode an MP4. Returns the encoder label used."""
    if np is None:
        raise RuntimeError("Install python3-numpy to analyze audio.")
    if not which("ffmpeg"):
        raise RuntimeError("Install ffmpeg to decode audio and encode MP4.")
    look = merge_look(look)
    progress = progress or (lambda _msg, _pct: None)
    samples, sr = decode_audio(audio_path)
    duration = samples.size / sr
    analyzer = Analyzer(samples, sr)
    ow, oh = frame_wh(look["aspect"], look["res"])
    fps = int(look.get("fps") or 30)
    frames = max(1, int(duration * fps))
    theme = theme_pair_from_look(look)
    bounce = BOUNCE.get(look.get("bounce", "Medium"), 1.0)
    progress("Checking VA-API GPU…", 0)
    software_v, vaapi_device, acodec = pick_ffmpeg_codecs()
    engine = None
    if look.get("mode") == "3D":
        try:
            from engine3d import try_create
        except ImportError:
            try:
                from desktop.engine3d import try_create  # type: ignore
            except ImportError:
                try_create = None  # type: ignore
        if try_create is not None:
            progress(f"Starting 3D engine ({look['res']})…", 0)
            engine = try_create(ow, oh)
            if engine is not None:
                engine.set_cover(cover)
    attempts: list[tuple[str, list[str]]] = []
    if vaapi_device:
        attempts.append(
            (
                f"VA-API ({vaapi_device})",
                build_ffmpeg_cmd(dest, audio_path, software_v, vaapi_device, acodec, ow, oh, fps),
            )
        )
    attempts.append(
        ("CPU", build_ffmpeg_cmd(dest, audio_path, software_v, None, acodec, ow, oh, fps))
    )
    last_err = ""
    for idx, (label, cmd) in enumerate(attempts):
        progress(f"Rendering with {label}…", 0)
        rc, last_err = pipe_encode(
            cmd,
            frames,
            cover,
            analyzer,
            duration,
            theme,
            bounce,
            look,
            song,
            artist,
            album,
            engine,
            logo,
            fps,
            progress,
        )
        if rc == 0:
            return label
        if idx + 1 < len(attempts):
            progress("GPU encode failed, falling back to CPU…", 0)
    detail = last_err.strip() or "ffmpeg failed to encode the video"
    raise RuntimeError(detail[-800:])


def pipe_encode(
    cmd: list[str],
    frames: int,
    cover: Image.Image,
    analyzer: Analyzer,
    duration: float,
    theme: tuple[str, str, str],
    bounce: float,
    look: dict,
    song: str,
    artist: str,
    album: str,
    engine: object | None,
    logo: Image.Image | None,
    fps: int,
    progress,
) -> tuple[int, str]:
    err_file = tempfile.NamedTemporaryFile(prefix="renderbolt-ffmpeg-", suffix=".log", delete=False)
    err_path = err_file.name
    err_file.close()
    proc: subprocess.Popen[bytes] | None = None
    log = ""
    try:
        with open(err_path, "wb") as err:
            proc = subprocess.Popen(cmd, stdin=subprocess.PIPE, stderr=err)
            assert proc.stdin is not None
            dt = 1 / max(1, fps)
            zoom_state = [1.12]
            place = look.get("place") or {}
            out_size = None if engine is not None else frame_wh(look["aspect"], look["res"])
            for i in range(frames):
                t = i * dt
                frame = render_frame(
                    cover,
                    analyzer.at(t, dt, float(look.get("sens", 1))),
                    t,
                    duration,
                    look.get("style", "Waveform"),
                    theme,
                    song,
                    artist,
                    album,
                    bounce,
                    bool(look.get("show_titles", True)),
                    zoom_state,
                    engine,
                    float(look.get("tilt", 42)),
                    float(look.get("alpha", 0.78)),
                    out_size,
                    look.get("mode", "3D"),
                    place,
                    bool(look.get("show_progress", True)),
                    float(look.get("glow", 0.4)),
                    float(look.get("vignette", 0.55)),
                    float(look.get("grain", 0.1)),
                    float(look.get("title_scale", 1)),
                    logo,
                    float(look.get("fade_in", 0.6)),
                    float(look.get("fade_out", 1.2)),
                    look.get("title_pos", "Bottom"),
                    float(look.get("pulse_hue", 0)),
                )
                proc.stdin.write(frame.tobytes())
                if i % 10 == 0:
                    progress(f"Rendering {i}/{frames}", 100 * i / frames)
            proc.stdin.close()
            rc = proc.wait()
    except BrokenPipeError:
        if proc is not None:
            proc.wait()
        rc = proc.returncode if proc is not None and proc.returncode else 1
    except Exception:
        if proc is not None and proc.poll() is None:
            proc.kill()
            proc.wait()
        raise
    finally:
        try:
            log = Path(err_path).read_text(errors="replace")
        except OSError:
            log = ""
        try:
            os.unlink(err_path)
        except OSError:
            pass
    return rc, log


