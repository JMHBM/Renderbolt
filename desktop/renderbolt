            "github.com/JMHBM/Renderbolt\n\n"
            "1–6 starter looks   F1 about   S frame   G generate",
        )

    def save_look(self) -> None:
        path = filedialog.asksaveasfilename(
            title="Save look",
            defaultextension=".json",
            filetypes=[("Renderbolt look", "*.json")],
            initialfile="renderbolt-look.json",
        )
        if not path:
            return
        Path(path).write_text(json.dumps(self.dump_look(), indent=2))
        self.status.set(f"Saved look {os.path.basename(path)}")

    def load_look(self) -> None:
        path = filedialog.askopenfilename(title="Load look", filetypes=[("Renderbolt look", "*.json"), ("All", "*.*")])
        if not path:
            return
        self.apply_look(json.loads(Path(path).read_text()))
        self.status.set(f"Loaded {os.path.basename(path)}")

    def snapshot(self) -> None:
        path = filedialog.asksaveasfilename(
            title="Save frame",
            defaultextension=".png",
            filetypes=[("PNG image", "*.png")],
            initialfile=f"{self.song.get() or 'renderbolt'}-frame.png",
            initialdir=self._export_dir or None,
        )
        if not path:
            return
        try:
            self._render_preview()
            frame = self._current_frame(export=True)
            frame.save(path)
            self._export_dir = str(Path(path).parent)
            self.status.set(f"Saved frame {os.path.basename(path)}")
        except Exception as exc:
            messagebox.showerror(APP_NAME, str(exc))

    def _current_frame(self, export: bool = False) -> Image.Image:
        if self._analyzer is None:
            raise RuntimeError("No audio to frame.")
        g = self._grade()
        dt = 1 / max(1, int(self.fps_var.get() or 30))
        analysis = self._analyzer.at(self._t0, dt, float(self.sens_var.get()))
        theme = (*self._theme_pair(), self._theme_pair()[1])
        size = frame_wh(self.aspect_var.get(), self.res_var.get()) if export else self._preview_wh()
        cover = self.cover or Image.new("RGB", size, (12, 12, 16))
        return render_frame(
            cover,
            analysis,
            self._t0,
            self._duration,
            self.style_var.get(),
            theme,
            self.song.get(),
            self.artist.get(),
            self.album.get(),
            BOUNCE.get(self.bounce_var.get(), 1.0),
            self.show_titles.get(),
            [1.12],
            None,
            float(self.tilt_var.get()),
            float(self.alpha_var.get()),
            size,
            self.mode_var.get(),
            self._place(),
            self.show_progress.get(),
            g["glow"],
            g["vignette"],
            g["grain"],
            g["title_scale"],
            self.logo_im,
            g["fade_in"],
            g["fade_out"],
            g["title_pos"],
            g["pulse_hue"],
        )

    def toggle_play(self) -> None:
        if self._playing:
            self._playing = False
            self.play_btn.configure(text="▶")
            self._stop_audio()
            return
        self._playing = True
        self._clock = time.perf_counter() - self._t0
        self.play_btn.configure(text="⏸")
        self._start_audio()
        if not self._preview_job:
            self._play_watch()

    def _start_audio(self) -> None:
        self._stop_audio()
        path = self.audio_path
        play = ffplay_bin()
        if not path or not play:
            return
        self._player = subprocess.Popen(
            [play, "-nodisp", "-autoexit", "-ss", f"{self._t0:.2f}", "-loglevel", "quiet", path],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            **_popen_kw(),
        )

    def _stop_audio(self) -> None:
        if self._player is not None:
            self._player.terminate()
            try:
                self._player.wait(timeout=0.4)
            except Exception:
                self._player.kill()
            self._player = None

    def _mark_preview_dirty(self, *_args) -> None:
        if getattr(self, "_suspend_preview", False):
            return
        self._preview_dirty = True
        if self._playing:
            return
        if self._idle_preview_job:
            try:
                self.after_cancel(self._idle_preview_job)
            except tk.TclError:
                pass
        self._idle_preview_job = self.after(90, self._idle_preview)

    def _idle_preview(self) -> None:
        self._idle_preview_job = None
        self._render_preview()

    def _sync_time_label(self) -> None:
        p = 0 if self._duration <= 0 else 100 * (self._t0 / self._duration)
        try:
            self.pbar["value"] = p
            self.time_var.set(
                f"{int(self._t0 // 60)}:{int(self._t0 % 60):02d} / "
                f"{int(self._duration // 60)}:{int(self._duration % 60):02d}"
            )
        except tk.TclError:
            pass

    def _play_watch(self) -> None:
        """Advance the clock / audio only. Never redraw the preview image."""
        if not self._playing:
            self._preview_job = None
            return
        self._t0 = time.perf_counter() - self._clock
        if self._t0 >= self._duration:
            if self.loop_preview.get():
                self._t0 = 0.0
                self._clock = time.perf_counter()
                self._start_audio()
            else:
                self._t0 = 0.0
                self._playing = False
                self.play_btn.configure(text="▶")
                self._stop_audio()
                self._preview_job = None
                self._sync_time_label()
                return
        elif self._player is not None and self._player.poll() is not None:
            if self.loop_preview.get():
                self._t0 = 0.0
                self._clock = time.perf_counter()
                self._start_audio()
            else:
                self._playing = False
                self.play_btn.configure(text="▶")
                self._preview_job = None
                self._sync_time_label()
                return
        self._sync_time_label()
        self._preview_job = self.after(250, self._play_watch)

    def _watch_preview_vars(self) -> None:
        skip = {"time_var", "status"}
        for name in dir(self):
            if name in skip or name.startswith("_"):
                continue
            obj = getattr(self, name, None)
            if isinstance(obj, (tk.StringVar, tk.DoubleVar, tk.BooleanVar, tk.IntVar)):
                try:
                    obj.trace_add("write", self._mark_preview_dirty)
                except tk.TclError:
                    pass

    def _render_preview(self) -> None:
        if self.cover is None or self._analyzer is None:
            return
        try:
            w, h = self._preview_wh()
            analysis = self._analyzer.at(self._t0, 1 / 24, float(self.sens_var.get()))
            theme = self._theme_pair()
            cover = self._cover_for_preview(w, h)
            img = cover.convert("RGBA")
            img = Image.alpha_composite(img, Image.new("RGBA", (w, h), (10, 10, 11, 70)))
            try:
                from preview3d import draw_lite
            except ImportError:
                from desktop.preview3d import draw_lite  # type: ignore
            draw_lite(
                img,
                analysis,
                self.style_var.get(),
                theme,
                float(self.alpha_var.get()),
                self._place(),
            )
            g = self._grade()
            draw_chrome(
                img,
                self._t0,
                self._duration,
                hex_rgb(theme[0]),
                self.song.get(),
                self.artist.get(),
                self.album.get(),
                self.show_titles.get(),
                self.show_progress.get(),
                g["title_scale"],
                g["title_pos"],
            )
            self.preview_imgtk = ImageTk.PhotoImage(img.convert("RGB"))
            self.preview.configure(image=self.preview_imgtk)
        except Exception:
            pass

    def _cover_for_preview(self, w: int, h: int) -> Image.Image:
        key = (id(self.cover), w, h)
        if self._cover_key == key and self._cover_small is not None:
            return self._cover_small
        src = self.cover or Image.new("RGB", (w, h), (12, 12, 16))
        self._cover_small = src.convert("RGB").resize((w, h), Image.Resampling.BILINEAR)
        self._cover_key = key
        return self._cover_small

    def _preview_wh(self) -> tuple[int, int]:
        pw = max(320, int(self.preview.winfo_width() or 640))
        ph = max(180, int(self.preview.winfo_height() or 360))
        ar = ASPECTS.get(self.aspect_var.get(), (16, 9))
        if pw / ph > ar[0] / ar[1]:
            pw = int(ph * ar[0] / ar[1])
        else:
            ph = int(pw * ar[1] / ar[0])
        cap = 400 if WIN else 560
        if self._preview_ms > 90:
            cap = 360
        scale = min(1.0, cap / max(pw, ph, 1))
        return max(160, int(pw * scale)), max(160, int(ph * scale))

    def _theme_pair(self) -> tuple[str, str]:
        return (self.base_color.get() or "#156a96", self.tip_color.get() or "#b8ecff")

    def _place(self) -> dict:
        return {
            "x": float(self.vis_x.get()),
            "y": float(self.vis_y.get()),
            "rot": float(self.vis_rot.get()),
            "sx": float(self.vis_sx.get()),
            "sy": float(self.vis_sy.get()),
            "mirror": bool(self.mirror.get()),
        }

    def pick_audio(self) -> None:
        path = filedialog.askopenfilename(
            title="Audio file",
            filetypes=[("Audio", "*.mp3 *.wav *.flac *.ogg *.m4a *.aac"), ("All", "*.*")],
            initialdir=self._audio_dir or None,
        )
        if not path:
            return
        self._audio_dir = str(Path(path).parent)
        self._load_audio(path)

    def _load_audio(self, path: str) -> None:
        self.audio_path = path
        self.audio_var.set(os.path.basename(path))
        self.status.set("Decoding audio…")
        self.update_idletasks()
        try:
            samples, sr = decode_audio(path)
            self._analyzer = Analyzer(samples, sr)
            self._duration = samples.size / sr
            self._using_demo = False
            self._t0 = 0.0
            self.status.set("Ready · preview is live")
        except Exception as exc:
            messagebox.showerror(APP_NAME, str(exc))
            self.status.set("Could not decode audio")

    def pick_image(self) -> None:
        path = filedialog.askopenfilename(
            title="Background image",
            filetypes=[("Images", "*.jpg *.jpeg *.png *.webp"), ("All", "*.*")],
            initialdir=self._image_dir or None,
        )
        if not path:
            return
        self._image_dir = str(Path(path).parent)
        self.image_path = path
        self.image_var.set(os.path.basename(path))
        self._load_cover(path)

    def _load_cover(self, path: str | None) -> None:
        if not path or not os.path.isfile(path):
            self.cover = Image.new("RGB", (W, H), (12, 12, 16))
        else:
            self.cover = Image.open(path).convert("RGB")
        self._cover_key = None
        self._zoom_preview = [1.12]
        self._render_preview()

    def generate(self) -> None:
        if getattr(self, "_exporting", False):
            return
        if not self.audio_path:
            messagebox.showinfo(APP_NAME, "Choose an audio file first.")
            return
        dest = filedialog.asksaveasfilename(
            title="Save MP4",
            defaultextension=".mp4",
            filetypes=[("MP4 video", "*.mp4")],
            initialfile=f"{self.song.get() or 'renderbolt'}.mp4",
            initialdir=self._export_dir or None,
        )
        if not dest:
            return
        self._export_dir = str(Path(dest).parent)
        was_playing = self._playing
        self._playing = False
        self._stop_audio()
        if self._preview_job:
            self.after_cancel(self._preview_job)
            self._preview_job = None

        look = self.dump_look()
        cover = (self.cover or Image.new("RGB", (W, H), (12, 12, 16))).copy()
        logo = self.logo_im.copy() if self.logo_im is not None else None
        song, artist, album = self.song.get(), self.artist.get(), self.album.get()
        audio_path = self.audio_path

        self._exporting = True
        self.gen_btn.configure(text="  Rendering…  ", cursor="arrow")
        self.status.set("Starting export…")
        last_ui = [0.0]

        def progress(msg: str, pct: float) -> None:
            now = time.monotonic()
            if now - last_ui[0] < 0.08 and pct < 99:
                return
            last_ui[0] = now

            def apply(m: str = msg, p: float = pct) -> None:
                try:
                    self.status.set(m)
                    if p:
                        self.pbar["value"] = p
                except tk.TclError:
                    pass

            self.after(0, apply)

        def work() -> None:
            try:
                label = run_export(
                    audio_path,
                    dest,
                    cover,
                    look,
                    song,
                    artist,
                    album,
                    logo,
                    progress,
                )
                self.after(0, lambda: self._generate_done(dest, label, None, was_playing))
            except Exception as exc:
                _write_vaapi_log("generate failed\n" + traceback.format_exc())
                self.after(0, lambda e=exc: self._generate_done(dest, "", e, was_playing))

        threading.Thread(target=work, daemon=True, name="renderbolt-export").start()

    def _generate_done(self, dest: str, label: str, err: Exception | None, was_playing: bool) -> None:
        self._exporting = False
        try:
            self.gen_btn.configure(text="  Generate MP4  ", cursor="hand2")
        except tk.TclError:
            return
        if err is not None:
            messagebox.showerror(APP_NAME, str(err))
            self.status.set("Generate failed")
        else:
            self.pbar["value"] = 100
            self.status.set(f"Saved {dest} · {label}")
            self._persist()
            messagebox.showinfo(APP_NAME, f"Saved {dest}\nEncoder: {label}")
        self._playing = False
        self.play_btn.configure(text="▶")
        self.after(80, self._render_preview)


def parse_args(argv: list[str] | None = None) -> argparse.Namespace:
    p = argparse.ArgumentParser(add_help=False, prog="renderbolt")
    p.add_argument("command", nargs="?", default="")
    p.add_argument("--audio")
    p.add_argument("--cover")
    p.add_argument("--out")
    p.add_argument("--look")
    p.add_argument("--preset")
    p.add_argument("--mode")
    p.add_argument("--style")
    p.add_argument("--theme")
    p.add_argument("--title", default="")
    p.add_argument("--artist", default="")
    p.add_argument("--album", default="")
    p.add_argument("--aspect")
    p.add_argument("--res")
    p.add_argument("--fps")
    p.add_argument("--list-presets", action="store_true")
    p.add_argument("--probe-gpu", action="store_true")
    p.add_argument("--version", action="store_true")
    p.add_argument("-h", "--help", action="store_true")
    return p.parse_args(argv)


def resolve_look_file(path: str) -> Path:
    raw = Path(path)
    if raw.is_file():
        return raw
    candidates = [
        raw,
        LOOKS_DIR / path,
        LOOKS_DIR / f"{path}.json",
        HERE / "looks" / path,
        HERE / "looks" / f"{path}.json",
        Path("/opt/renderbolt/share/looks") / path,
        Path("/opt/renderbolt/share/looks") / f"{path}.json",
    ]
    for cand in candidates:
        if cand.is_file():
            return cand
    raise FileNotFoundError(f"look not found: {path}")


def cli_render(args: argparse.Namespace) -> int:
    if not args.audio or not args.out:
        print("render needs --audio and --out", file=sys.stderr)
        return 2
    look = default_look()
    if args.preset:
        key = next((k for k in STARTER_LOOKS if k.lower() == args.preset.lower()), None)
        if not key:
            print(f"unknown preset {args.preset!r}", file=sys.stderr)
            print("presets:", ", ".join(STARTER_LOOKS), file=sys.stderr)
            return 2
        look = merge_look(look, STARTER_LOOKS[key])
    if args.look:
        look = merge_look(look, json.loads(resolve_look_file(args.look).read_text()))
    overrides = {}
    if args.mode:
        overrides["mode"] = args.mode
    if args.style:
        overrides["style"] = args.style
    if args.theme:
        overrides["theme"] = args.theme
        if args.theme in THEMES:
            overrides["base"], overrides["tip"] = THEMES[args.theme]
    if args.aspect:
        overrides["aspect"] = args.aspect
    if args.res:
        overrides["res"] = args.res
    if args.fps:
        overrides["fps"] = str(args.fps)
    look = merge_look(look, overrides)
    cover_path = args.cover or (DEFAULT_COVER if os.path.isfile(DEFAULT_COVER) else None)
    cover = Image.open(cover_path).convert("RGB") if cover_path else Image.new("RGB", (W, H), (12, 12, 16))

    def progress(msg: str, pct: float) -> None:
        if pct:
            print(f"{msg}  {pct:5.1f}%", flush=True)
        else:
            print(msg, flush=True)

    label = run_export(
        args.audio,
        args.out,
        cover,
        look,
        args.title,
        args.artist,
        args.album,
        None,
        progress,
    )
    print(f"saved {args.out} · {label}")
    return 0


def print_gpu_probe() -> int:
    print(f"ffmpeg: {ffmpeg_bin() or 'NOT FOUND'}")
    if ffmpeg_is_snap():
        print("warning: snap ffmpeg is often blocked from /dev/dri")
        print("         sudo apt install ffmpeg")
    enc = ffmpeg_encoders()
    if WIN:
        wanted = [e for e in ("h264_amf", "h264_nvenc", "h264_qsv", "libx264") if e in enc]
        print("windows encoders:", ", ".join(wanted) or "(none)")
        hw = pick_hw_session()
        print()
        print("production probe is raw RGB24 1920x1080 on stdin (same as Generate).")
        if hw:
            print("selected:", hw["label"])
            print("log:", CONFIG_PATH.parent / "vaapi.log")
            return 0
        print("no hardware encoder — exports will use the CPU (libx264)")
        print("AMD: h264_amf   NVIDIA: h264_nvenc   Intel: h264_qsv")
        return 1
    va = [e for e in sorted(enc) if "vaapi" in e]
    print("vaapi encoders:", ", ".join(va) or "(none)")
    nodes = vaapi_render_nodes()
    if not nodes:
        print("no /dev/dri/renderD* nodes — is the GPU driver loaded?")
        return 1
    print("render nodes (AMD first):")
    for n in nodes:
        print(f"  {dri_pretty(n)}")
        print(f"    vendor={dri_vendor(n) or '?'}  vram={dri_vram(n)}  driver={dri_driver(n) or '?'}")
        env = ffmpeg_env_for(n)
        advertised = vainfo_encode_codecs(n, env)
        print(f"    vainfo encode={advertised or 'unknown (install vainfo)'}")
    hw = pick_hw_session()
    print()
    print("production probe is raw RGB24 1920x1080 on stdin (same as Generate).")
    if hw:
        print("selected:", hw["label"])
        print("log: ~/.config/renderbolt/vaapi.log")
        return 0
    print("no working VA-API session — exports will use the CPU")
    print("try:  sudo apt install mesa-va-drivers vainfo ffmpeg")
    print("log: ~/.config/renderbolt/vaapi.log")
    return 1


def main() -> None:
    args = parse_args()
    if args.help:
        print(HELP_TEXT)
        return
    if args.version and not args.out:
        print(f"{APP_NAME} {VERSION} · {AUTHOR} · {LICENSE}")
        return
    if args.list_presets:
        for name in STARTER_LOOKS:
            print(name)
        return
    if args.probe_gpu:
        raise SystemExit(print_gpu_probe())
    if args.command == "render" or args.out:
        raise SystemExit(cli_render(args))
    app = App()
    app.mainloop()


if __name__ == "__main__":
    main()
