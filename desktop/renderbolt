def ffmpeg_bin() -> str | None:
    """Prefer a bundled or distro ffmpeg. Snap's ffmpeg is usually blocked from /dev/dri."""
    env = os.environ.get("RENDERBOLT_FFMPEG")
    if env and os.path.isfile(env):
        return env
    names = ("ffmpeg.exe", "ffmpeg") if WIN else ("ffmpeg",)
    ordered: list[str] = []
    for name in names:
        found = shutil.which(name)
        if found:
            ordered.append(found)
        for folder in (APP_DIR, HERE, APP_DIR / "ffmpeg", HERE / "ffmpeg"):
            cand = folder / name
            if cand.is_file():
                ordered.append(str(cand))
    if not WIN:
        for p in ("/usr/bin/ffmpeg", "/usr/local/bin/ffmpeg"):
            if p not in ordered:
                ordered.append(p)
    non_snap: list[str] = []
    snap: list[str] = []
    seen: set[str] = set()
    for p in ordered:
        if p in seen or not os.path.isfile(p):
            continue
        seen.add(p)
        try:
            real = os.path.realpath(p)
        except OSError:
            real = p
        (snap if "/snap/" in real.replace("\\", "/") else non_snap).append(p)
    if non_snap:
        return non_snap[0]
    return snap[0] if snap else None


def ffplay_bin() -> str | None:
    env = os.environ.get("RENDERBOLT_FFPLAY")
    if env and os.path.isfile(env):
        return env
    names = ("ffplay.exe", "ffplay") if WIN else ("ffplay",)
    for name in names:
        found = shutil.which(name)
        if found:
            return found
        for folder in (APP_DIR, HERE, Path(ffmpeg_bin() or ".").parent):
            cand = Path(folder) / name
            if cand.is_file():
                return str(cand)
    return None


def ffmpeg_encoders() -> set[str]:
    bin_ = ffmpeg_bin()
    if not bin_:
        return set()
    try:
        out = subprocess.check_output(
            [bin_, "-hide_banner", "-encoders"],
            stderr=subprocess.STDOUT,
            text=True,
            **_popen_kw(),
        )
    except (OSError, subprocess.CalledProcessError):
        return set()
    names: set[str] = set()
    for line in out.splitlines():
        parts = line.strip().split()
        if len(parts) >= 2 and parts[0][:1] in "VAS":
            names.add(parts[1])
    return names


def vaapi_render_nodes() -> list[str]:
    env = os.environ.get("RENDERBOLT_VAAPI_DEVICE") or os.environ.get("LIBVA_DEVICE")
    nodes: list[str] = []
    if env and os.path.exists(env):
        nodes.append(env)
    found: list[str] = []
    dri = Path("/dev/dri")
    if dri.is_dir():
        found = [str(p) for p in sorted(dri.glob("renderD*"))]

    def rank(n: str) -> tuple:
        vendor = dri_vendor(n)
        # AMD first (dGPU usually has more VRAM than the APU), then Intel, then others.
        family = {PCI_AMD: 0, PCI_INTEL: 1, PCI_NVIDIA: 2}.get(vendor, 3)
        return (family, -dri_vram(n), n)

    for n in sorted(found, key=rank):
        if n not in nodes:
            nodes.append(n)
    return nodes


def dri_sys(node: str, rel: str) -> Path:
    return Path("/sys/class/drm") / Path(node).name / rel


def dri_vendor(node: str) -> str:
    try:
        return dri_sys(node, "device/vendor").read_text().strip().lower()
    except OSError:
        return ""


def dri_vram(node: str) -> int:
    try:
        return int(dri_sys(node, "device/mem_info_vram_total").read_text().strip())
    except (OSError, ValueError):
        return 0


def dri_driver(node: str) -> str:
    try:
        return os.path.basename(os.readlink(dri_sys(node, "device/driver")))
    except OSError:
        return ""


def dri_pci_prime(node: str) -> str:
    """Mesa DRI_PRIME value for this render node, e.g. pci-0000_03_00_0."""
    try:
        bus = os.path.basename(os.path.realpath(dri_sys(node, "device")))
        if ":" not in bus:
            return ""
        return "pci-" + bus.replace(":", "_").replace(".", "_")
    except OSError:
        return ""


def dri_pretty(node: str) -> str:
    vendor = VENDOR_NAME.get(dri_vendor(node), dri_vendor(node) or "GPU")
    driver = dri_driver(node)
    vram = dri_vram(node)
    gb = f" {vram / (1024 ** 3):.1f}GB" if vram else ""
    extra = f", {driver}" if driver else ""
    return f"{vendor}{gb} ({Path(node).name}{extra})"


def ffmpeg_is_snap() -> bool:
    p = ffmpeg_bin()
    if not p:
