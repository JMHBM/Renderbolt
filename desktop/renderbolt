def hex_rgb(h: str) -> tuple[int, int, int]:
    h = h.lstrip("#")
    return int(h[0:2], 16), int(h[2:4], 16), int(h[4:6], 16)


def lerp(a: float, b: float, t: float) -> float:
    return a + (b - a) * t


def clamp(v: float, lo: float = 0.0, hi: float = 1.0) -> float:
    return max(lo, min(hi, v))


def frame_wh(aspect: str, res: str) -> tuple[int, int]:
    long_e = {"720p": 1280, "1080p": 1920, "4K": 3840}.get(res, 1920)
    short_e = {"720p": 720, "1080p": 1080, "4K": 2160}.get(res, 1080)
    if aspect == "9:16":
        return short_e, long_e
    if aspect == "1:1":
        return short_e, short_e
    return long_e, short_e


def hue_shift(hex_color: str, degrees: float) -> str:
    import colorsys

    h = hex_color.lstrip("#")
    if len(h) != 6:
        return hex_color
    r, g, b = int(h[0:2], 16) / 255.0, int(h[2:4], 16) / 255.0, int(h[4:6], 16) / 255.0
    hh, s, v = colorsys.rgb_to_hsv(r, g, b)
    rr, gg, bb = colorsys.hsv_to_rgb((hh + degrees / 360.0) % 1.0, s, v)
    return f"#{int(rr * 255):02x}{int(gg * 255):02x}{int(bb * 255):02x}"


def fade_gain(t: float, duration: float, fade_in: float, fade_out: float) -> float:
    a = 1.0
    if fade_in > 0.01 and t < fade_in:
        a *= clamp(t / fade_in)
    if fade_out > 0.01 and duration - t < fade_out:
        a *= clamp((duration - t) / fade_out)
    return a


def which(cmd: str) -> str | None:
    return shutil.which(cmd)


def ffmpeg_encoders() -> set[str]:
    try:
        out = subprocess.check_output(
            ["ffmpeg", "-hide_banner", "-encoders"],
            stderr=subprocess.STDOUT,
            text=True,
        )
    except (OSError, subprocess.CalledProcessError):
        return set()
    names: set[str] = set()
    for line in out.splitlines():
        parts = line.strip().split()
        if len(parts) >= 2 and parts[0][:1] in "VAS":
            names.add(parts[1])
    return names


def vaapi_render_nodes() -> list[str]:
    env = os.environ.get("RENDERBOLT_VAAPI_DEVICE")
    nodes: list[str] = []
    if env and os.path.exists(env):
        nodes.append(env)
    if os.path.exists(VAAPI_DEVICE) and VAAPI_DEVICE not in nodes:
        nodes.append(VAAPI_DEVICE)
    dri = Path("/dev/dri")
    if dri.is_dir():
        for path in sorted(dri.glob("renderD*")):
            p = str(path)
            if p not in nodes:
                nodes.append(p)
    return nodes


def probe_vaapi(device: str) -> bool:
    """Cheap 6-frame encode to confirm h264_vaapi actually works on this node."""
    try:
        proc = subprocess.run(
            [
                "ffmpeg",
                "-hide_banner",
                "-nostdin",
                "-v",
                "error",
                "-vaapi_device",
                device,
                "-f",
                "lavfi",
                "-i",
                "color=c=black:s=128x128:d=0.2:r=30",
                "-filter_complex",
                "[0:v]format=nv12,hwupload[v]",
                "-map",
                "[v]",
                "-c:v",
                "h264_vaapi",
                "-f",
                "null",
                "-",
            ],
            check=False,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            timeout=8,
        )
        return proc.returncode == 0
    except (OSError, subprocess.TimeoutExpired):
        return False


def pick_ffmpeg_codecs() -> tuple[str, str | None, str]:
    """Return (software_vcodec, vaapi_device or None, acodec)."""
    enc = ffmpeg_encoders()
    audio = next((c for c in ("aac", "libmp3lame", "libopus") if c in enc), "aac")
    software = next((c for c in ("libx264", "libopenh264", "libx265", "mpeg4") if c in enc), "mpeg4")
    if "h264_vaapi" in enc:
        for device in vaapi_render_nodes():
            if probe_vaapi(device):
                return software, device, audio
    return software, None, audio


def build_ffmpeg_cmd(
    dest: str,
    audio_path: str,
    software_vcodec: str,
    vaapi_device: str | None,
    acodec: str,
    width: int = W,
    height: int = H,
    fps: int = FPS,
) -> list[str]:
    cmd = ["ffmpeg", "-y", "-hide_banner", "-nostdin"]
    if vaapi_device:
        cmd += ["-vaapi_device", vaapi_device]
    cmd += [
        "-f",
        "rawvideo",
        "-pix_fmt",
        "rgb24",
        "-s",
        f"{width}x{height}",
        "-r",
        str(fps),
        "-i",
        "-",
        "-i",
        audio_path,
    ]
    if vaapi_device:
        cmd += [
            "-filter_complex",
            "[0:v]format=nv12,hwupload[vout]",
            "-map",
            "[vout]",
            "-map",
            "1:a?",
            "-c:v",
            "h264_vaapi",
            "-qp",
            "18",
        ]
    else:
        cmd += ["-c:v", software_vcodec, "-pix_fmt", "yuv420p"]
        if software_vcodec == "libx264":
            cmd += ["-preset", "veryfast", "-crf", "18"]
    cmd += [
        "-c:a",
        acodec,
        "-b:a",
        "192k",
        "-shortest",
        "-movflags",
        "+faststart",
        dest,
    ]
    return cmd


def decode_audio(path: str, sr: int = 44100) -> tuple["np.ndarray", int]:
    if np is None:
        raise RuntimeError("python3-numpy is required")
    if not which("ffmpeg"):
        raise RuntimeError("ffmpeg is required to read audio")
    raw = subprocess.check_output(
        [
            "ffmpeg",
            "-v",
            "error",
            "-i",
            path,
            "-f",
            "f32le",
            "-acodec",
            "pcm_f32le",
            "-ac",
            "1",
            "-ar",
            str(sr),
            "pipe:1",
        ]
    )
    samples = np.frombuffer(raw, dtype=np.float32)
    return samples, sr


def log_bands(mag: "np.ndarray", n_bands: int, sr: int) -> "np.ndarray":
    n = mag.shape[0]
    fmin, fmax = 30.0, min(16000.0, sr / 2)
    ny = sr / 2
    bands = np.zeros(n_bands, dtype=np.float32)
    for b in range(n_bands):
        t0, t1 = b / n_bands, (b + 1) / n_bands
        hz0 = fmin * (fmax / fmin) ** t0
        hz1 = fmin * (fmax / fmin) ** t1
        i0 = max(0, int(hz0 / ny * n))
        i1 = min(n, max(i0 + 1, int(math.ceil(hz1 / ny * n))))
        raw = float(mag[i0:i1].mean()) if i1 > i0 else 0.0
        bands[b] = clamp((raw ** 0.62) * (0.75 + t0 * 0.7))
    return bands


class Analyzer:
    def __init__(self, samples: "np.ndarray", sr: int, fft_size: int = 2048) -> None:
        self.samples = samples
        self.sr = sr
        self.n = fft_size
        self.window = np.hanning(fft_size).astype(np.float32)
        self.avg = 0.1
        self.pulse = 0.0
        self.hold = 0.0

    def at(self, t: float, dt: float, sensitivity: float = 1.0) -> dict:
        s = max(0.25, min(2.5, float(sensitivity)))
        center = int(t * self.sr)
        half = self.n // 2
        start = center - half
        chunk = np.zeros(self.n, dtype=np.float32)
        lo = max(0, start)
        hi = min(self.samples.size, start + self.n)
        if hi > lo:
            chunk[lo - start : hi - start] = self.samples[lo:hi]
        spec = np.fft.rfft(chunk * self.window)
        mag = np.abs(spec) / self.n * 8
        bands = log_bands(mag, 64, self.sr)
        bands = np.clip(bands * (0.55 + 0.7 * s), 0, 1)
        bass_n = max(1, int(len(bands) * 0.14))
        bass = float(bands[:bass_n].mean())
        rms = float(np.sqrt(np.mean(chunk * chunk)) * 2.4)
        onset = bass - self.avg
        self.avg += (bass - self.avg) * min(1.0, dt * 3) * 0.35
        thresh = 0.07 / s
        if onset > thresh and bass > 0.12 / s and self.hold <= 0:
            self.pulse = clamp((0.5 + onset * 2.4) * s)
            self.hold = 0.11
        self.hold = max(0.0, self.hold - dt)
        self.pulse *= 0.08 ** dt
        return {
            "time": chunk,
            "bands": bands,
            "bass": bass,
            "pulse": self.pulse,
            "rms": clamp(rms),
        }


def make_demo(sr: int = 44100, seconds: float = 16.0, bpm: float = 124.0) -> tuple["np.ndarray", int]:
    if np is None:
        raise RuntimeError("python3-numpy is required")
    n = int(sr * seconds)
    t = np.arange(n, dtype=np.float32) / sr
    y = np.zeros(n, dtype=np.float32)
    beat = 60.0 / bpm
    rng = np.random.default_rng(7)
    noise = rng.standard_normal(n).astype(np.float32)
    for i in range(int(seconds / beat)):
        t0 = i * beat
        age = np.maximum(t - t0, 0.0)
        gate = (t >= t0).astype(np.float32)
        kick_env = np.exp(-age * 14.0) * gate
        freq = 140.0 * np.exp(-age * 18.0)
        y += np.sin(2 * np.pi * freq * age) * kick_env * 0.9
        if i % 2 == 1:
            y += noise * np.exp(-age * 18.0) * gate * 0.28
        y += noise * np.exp(-age * 55.0) * gate * 0.12
    y += 0.08 * np.sin(2 * np.pi * 55 * t) * (0.5 + 0.5 * np.sin(2 * np.pi * t / 8))
    peak = float(np.max(np.abs(y))) or 1.0
    return (y / peak * 0.9).astype(np.float32), sr


def cover_draw(base: Image.Image, cover: Image.Image, zoom: float, pulse: float, w: int | None = None, h: int | None = None) -> None:
    w = w or W
    h = h or H
    cw, ch = cover.size
    scale = max(w / cw, h / ch) * zoom
    nw, nh = int(cw * scale), int(ch * scale)
    resized = cover.resize((nw, nh), Image.Resampling.LANCZOS)
    x = (w - nw) // 2
    y = int((h - nh) / 2 + pulse * h * -0.008)
    base.paste(resized, (x, y))
    overlay = Image.new("RGBA", (w, h), (10, 10, 11, 0))
    draw = ImageDraw.Draw(overlay)
    edge = int(24 + pulse * 36)
    for i in range(edge):
        a = int(180 * (1 - i / edge) * (0.45 + pulse * 0.4))
        draw.rectangle([i, i, w - 1 - i, h - 1 - i], outline=(10, 10, 11, a))
    base.alpha_composite(overlay)
    fade = Image.new("RGBA", (w, h), (0, 0, 0, 0))
    fd = ImageDraw.Draw(fade)
    for i in range(int(h * 0.55)):
        a = int(200 * (i / (h * 0.55)))
        y0 = int(h * 0.45) + i
        fd.line([(0, y0), (w, y0)], fill=(10, 10, 11, a))
    base.alpha_composite(fade)


def apply_grade(img: Image.Image, vignette: float, grain: float, t: float) -> Image.Image:
    if (vignette <= 0.01 and grain <= 0.01) or np is None:
        return img
    rgb = img.convert("RGB")
    arr = np.asarray(rgb).astype(np.float32)
    h, w = arr.shape[:2]
    if vignette > 0.01:
        yy = np.linspace(-1.0, 1.0, h, dtype=np.float32)[:, None]
        xx = np.linspace(-1.0, 1.0, w, dtype=np.float32)[None, :]
        r = np.sqrt(xx * xx + yy * yy)
        vig = 1.0 - float(vignette) * np.clip((r - 0.28) / 1.15, 0.0, 1.0) ** 1.35
        arr *= vig[..., None]
    if grain > 0.01:
        rng = np.random.default_rng(int(t * 24) & 0xFFFF)
        noise = rng.standard_normal((h, w)).astype(np.float32) * (grain * 16.0)
        arr += noise[..., None]
    out = Image.fromarray(np.clip(arr, 0, 255).astype(np.uint8), "RGB")
    if img.mode == "RGBA":
        a = img.getchannel("A")
        out = out.convert("RGBA")
        out.putalpha(a)
    return out


def draw_logo(img: Image.Image, logo: Image.Image | None) -> None:
    if logo is None:
        return
    w, h = img.size
    mark = logo.convert("RGBA")
    mw = max(48, int(w * 0.12))
    mh = int(mark.height * (mw / max(1, mark.width)))
    mark = mark.resize((mw, mh), Image.Resampling.LANCZOS)
    img.alpha_composite(mark, (w - mw - int(w * 0.05), h - mh - int(h * 0.08)))


def font(size: int, bold: bool = False) -> ImageFont.ImageFont:
    candidates = [
        "/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf" if bold else "/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf",
        "/usr/share/fonts/truetype/liberation/LiberationSans-Bold.ttf" if bold else "/usr/share/fonts/truetype/liberation/LiberationSans-Regular.ttf",
    ]
    for path in candidates:
        if os.path.isfile(path):
            return ImageFont.truetype(path, size)
    return ImageFont.load_default()


