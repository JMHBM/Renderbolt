def pick_d3d_hw_session() -> dict | None:
    """Windows hardware encode: AMD AMF, then NVIDIA NVENC, then Intel QSV."""
    global _HW_CACHE
    if _HW_CACHE != "unset":
        return _HW_CACHE  # type: ignore[return-value]
    enc = ffmpeg_encoders()
    notes: list[str] = []
    recipes: list[tuple[str, str, list[str]]] = [
        (
            "h264_amf",
            "AMD AMF",
            ["-c:v", "h264_amf", "-quality", "balanced", "-rc", "cqp", "-qp_i", "18", "-qp_p", "18"],
        ),
        (
            "h264_nvenc",
            "NVIDIA NVENC",
            ["-c:v", "h264_nvenc", "-preset", "p4", "-rc", "constqp", "-qp", "18"],
        ),
        (
            "h264_qsv",
            "Intel Quick Sync",
            ["-c:v", "h264_qsv", "-global_quality", "18"],
        ),
    ]
    bin_ = ffmpeg_bin() or "ffmpeg"
    w, h, nframes = 1920, 1080, 4
    payload = bytes(w * h * 3) * nframes
    for encoder, label, extra in recipes:
        if encoder not in enc:
            notes.append(f"{encoder}: not in this ffmpeg")
            continue
        cmd = [
            bin_,
            "-hide_banner",
            "-nostdin",
            "-v",
            "error",
            "-f",
            "rawvideo",
            "-pix_fmt",
            "rgb24",
            "-s",
            f"{w}x{h}",
            "-r",
            "30",
            "-i",
            "-",
            "-vf",
            "format=yuv420p",
            *extra,
            "-frames:v",
            str(nframes),
            "-f",
            "null",
            "-",
        ]
        try:
            proc = subprocess.run(
                cmd,
                input=payload,
                capture_output=True,
                timeout=20,
                **_popen_kw(),
            )
            log = (proc.stderr or proc.stdout or b"").decode("utf-8", "replace").strip()
            ok = proc.returncode == 0
        except (OSError, subprocess.TimeoutExpired) as exc:
            log = str(exc)
            ok = False
        notes.append(f"probe {encoder}: {'OK' if ok else 'fail'} {log[:300]}")
        if ok:
            session = {
                "kind": "d3d",
                "encoder": encoder,
                "extra_args": extra,
                "label": f"{label} · {encoder}",
                "env": os.environ.copy(),
            }
            _write_vaapi_log("selected " + session["label"] + "\n\n" + "\n".join(notes))
            _HW_CACHE = session
            return session
    _write_vaapi_log("no Windows hardware encoder; CPU fallback\n\n" + "\n".join(notes))
    _HW_CACHE = None
    return None


def pick_hw_session() -> dict | None:
    """Find a working hardware encoder (VA-API on Linux, AMF/NVENC/QSV on Windows)."""
    if WIN:
        return pick_d3d_hw_session()
    global _HW_CACHE
    if _HW_CACHE != "unset":
        return _HW_CACHE  # type: ignore[return-value]
    enc = ffmpeg_encoders()
    va_encoders = [e for e in ("h264_vaapi", "hevc_vaapi") if e in enc]
    notes: list[str] = []
    if ffmpeg_is_snap():
        notes.append("ffmpeg is a snap; confinement often blocks /dev/dri. Prefer: sudo apt install ffmpeg")
    if not va_encoders:
        notes.append("ffmpeg has no h264_vaapi/hevc_vaapi encoder")
        _write_vaapi_log("\n".join(notes))
        _HW_CACHE = None
        return None
    for device in vaapi_render_nodes():
        env = ffmpeg_env_for(device)
        advertised = vainfo_encode_codecs(device, env)
        notes.append(f"{dri_pretty(device)}  vainfo encode={advertised or 'unknown'}")
        order = list(va_encoders)
        if advertised:
            ranked = []
            if "h264" in advertised and "h264_vaapi" in va_encoders:
                ranked.append("h264_vaapi")
            if "hevc" in advertised and "hevc_vaapi" in va_encoders:
                ranked.append("hevc_vaapi")
            for extra in va_encoders:
                if extra not in ranked:
                    ranked.append(extra)
            order = ranked
        for encoder in order:
            ok, log = probe_vaapi(device, encoder, env)
            notes.append(f"  probe {encoder}: {'OK' if ok else 'fail'} {log[:300]}")
            if ok:
                session = {
                    "kind": "vaapi",
                    "device": device,
                    "encoder": encoder,
                    "env": env,
                    "extra": 128,
                    "label": f"VA-API {dri_pretty(device)} · {encoder}",
                }
                _write_vaapi_log("selected " + session["label"] + "\n\n" + "\n".join(notes))
                _HW_CACHE = session
                return session
    _write_vaapi_log("no working VA-API encoder; CPU fallback\n\n" + "\n".join(notes))
    _HW_CACHE = None
    return None


def pick_ffmpeg_codecs() -> tuple[str, dict | None, str]:
    """Return (software_vcodec, hw_session or None, acodec)."""
    enc = ffmpeg_encoders()
    audio = next((c for c in ("aac", "libmp3lame", "libopus") if c in enc), "aac")
    software = next((c for c in ("libx264", "libopenh264", "libx265", "mpeg4") if c in enc), "mpeg4")
    return software, pick_hw_session(), audio


def build_ffmpeg_cmd(
    dest: str,
    audio_path: str,
    software_vcodec: str,
    hw: dict | None,
    acodec: str,
    width: int = W,
    height: int = H,
    fps: int = FPS,
) -> list[str]:
    cmd = [ffmpeg_bin() or "ffmpeg", "-y", "-hide_banner", "-nostdin"]
    kind = (hw or {}).get("kind")
    if hw and kind != "d3d" and hw.get("device"):
        kind = "vaapi"
        cmd += [
            "-init_hw_device",
            f"vaapi=va:{hw['device']}",
            "-filter_hw_device",
            "va",
        ]
    cmd += [
        "-f",
        "rawvideo",
        "-pix_fmt",
        "rgb24",
        "-s",
        f"{width}x{height}",
        "-r",
        str(fps),
        "-i",
        "-",
        "-i",
        audio_path,
    ]
    if hw and kind == "vaapi":
        extra = int(hw.get("extra") or 128)
        cmd += [
            "-vf",
            f"format=nv12,hwupload=extra_hw_frames={extra}",
            "-map",
            "0:v",
            "-map",
            "1:a?",
            "-c:v",
            str(hw["encoder"]),
            "-qp",
            "18",
        ]
    elif hw and kind == "d3d":
        extra_args = list(hw.get("extra_args") or ["-c:v", str(hw["encoder"])])
        cmd += [
            "-vf",
            "format=yuv420p",
            "-map",
            "0:v",
            "-map",
            "1:a?",
            *extra_args,
        ]
    else:
        cmd += ["-c:v", software_vcodec, "-pix_fmt", "yuv420p"]
        if software_vcodec == "libx264":
            cmd += ["-preset", "veryfast", "-crf", "18"]
    cmd += [
        "-c:a",
        acodec,
        "-b:a",
        "192k",
        "-shortest",
        "-movflags",
        "+faststart",
        dest,
    ]
    return cmd


def decode_audio(path: str, sr: int = 44100) -> tuple["np.ndarray", int]:
    if np is None:
        raise RuntimeError("python3-numpy is required")
    if not ffmpeg_bin():
        raise RuntimeError("ffmpeg is required to read audio")
    raw = subprocess.check_output(
        [
            ffmpeg_bin() or "ffmpeg",
            "-v",
            "error",
            "-i",
            path,
            "-f",
            "f32le",
            "-acodec",
            "pcm_f32le",
            "-ac",
            "1",
            "-ar",
            str(sr),
            "pipe:1",
        ],
        **_popen_kw(),
    )
    samples = np.frombuffer(raw, dtype=np.float32)
    return samples, sr


def log_bands(mag: "np.ndarray", n_bands: int, sr: int) -> "np.ndarray":
    n = mag.shape[0]
    fmin, fmax = 30.0, min(16000.0, sr / 2)
    ny = sr / 2
    bands = np.zeros(n_bands, dtype=np.float32)
    for b in range(n_bands):
        t0, t1 = b / n_bands, (b + 1) / n_bands
        hz0 = fmin * (fmax / fmin) ** t0
        hz1 = fmin * (fmax / fmin) ** t1
        i0 = max(0, int(hz0 / ny * n))
        i1 = min(n, max(i0 + 1, int(math.ceil(hz1 / ny * n))))
        raw = float(mag[i0:i1].mean()) if i1 > i0 else 0.0
        bands[b] = clamp((raw ** 0.62) * (0.75 + t0 * 0.7))
    return bands


class Analyzer:
    def __init__(self, samples: "np.ndarray", sr: int, fft_size: int = 2048) -> None:
        self.samples = samples
        self.sr = sr
        self.n = fft_size
        self.window = np.hanning(fft_size).astype(np.float32)
        self.avg = 0.1
        self.pulse = 0.0
        self.hold = 0.0

    def at(self, t: float, dt: float, sensitivity: float = 1.0) -> dict:
        s = max(0.25, min(2.5, float(sensitivity)))
        center = int(t * self.sr)
        half = self.n // 2
        start = center - half
        chunk = np.zeros(self.n, dtype=np.float32)
        lo = max(0, start)
        hi = min(self.samples.size, start + self.n)
        if hi > lo:
            chunk[lo - start : hi - start] = self.samples[lo:hi]
        spec = np.fft.rfft(chunk * self.window)
        mag = np.abs(spec) / self.n * 8
        bands = log_bands(mag, 64, self.sr)
        bands = np.clip(bands * (0.55 + 0.7 * s), 0, 1)
        bass_n = max(1, int(len(bands) * 0.14))
        bass = float(bands[:bass_n].mean())
        rms = float(np.sqrt(np.mean(chunk * chunk)) * 2.4)
        onset = bass - self.avg
        self.avg += (bass - self.avg) * min(1.0, dt * 3) * 0.35
        thresh = 0.07 / s
        if onset > thresh and bass > 0.12 / s and self.hold <= 0:
            self.pulse = clamp((0.5 + onset * 2.4) * s)
            self.hold = 0.11
        self.hold = max(0.0, self.hold - dt)
        self.pulse *= 0.08 ** dt
        return {
            "time": chunk,
            "bands": bands,
            "bass": bass,
            "pulse": self.pulse,
            "rms": clamp(rms),
        }


def make_demo(sr: int = 44100, seconds: float = 16.0, bpm: float = 124.0) -> tuple["np.ndarray", int]:
    if np is None:
        raise RuntimeError("python3-numpy is required")
    n = int(sr * seconds)
    t = np.arange(n, dtype=np.float32) / sr
    y = np.zeros(n, dtype=np.float32)
    beat = 60.0 / bpm
    rng = np.random.default_rng(7)
    noise = rng.standard_normal(n).astype(np.float32)
    for i in range(int(seconds / beat)):
        t0 = i * beat
        age = np.maximum(t - t0, 0.0)
        gate = (t >= t0).astype(np.float32)
        kick_env = np.exp(-age * 14.0) * gate
        freq = 140.0 * np.exp(-age * 18.0)
        y += np.sin(2 * np.pi * freq * age) * kick_env * 0.9
        if i % 2 == 1:
            y += noise * np.exp(-age * 18.0) * gate * 0.28
        y += noise * np.exp(-age * 55.0) * gate * 0.12
    y += 0.08 * np.sin(2 * np.pi * 55 * t) * (0.5 + 0.5 * np.sin(2 * np.pi * t / 8))
    peak = float(np.max(np.abs(y))) or 1.0
    return (y / peak * 0.9).astype(np.float32), sr


def cover_draw(base: Image.Image, cover: Image.Image, zoom: float, pulse: float, w: int | None = None, h: int | None = None) -> None:
    w = w or W
    h = h or H
    cw, ch = cover.size
    scale = max(w / cw, h / ch) * zoom
    nw, nh = int(cw * scale), int(ch * scale)
    resized = cover.resize((nw, nh), Image.Resampling.LANCZOS)
    x = (w - nw) // 2
    y = int((h - nh) / 2 + pulse * h * -0.008)
    base.paste(resized, (x, y))
    overlay = Image.new("RGBA", (w, h), (10, 10, 11, 0))
    draw = ImageDraw.Draw(overlay)
    edge = int(24 + pulse * 36)
    for i in range(edge):
        a = int(180 * (1 - i / edge) * (0.45 + pulse * 0.4))
        draw.rectangle([i, i, w - 1 - i, h - 1 - i], outline=(10, 10, 11, a))
    base.alpha_composite(overlay)
    fade = Image.new("RGBA", (w, h), (0, 0, 0, 0))
    fd = ImageDraw.Draw(fade)
    for i in range(int(h * 0.55)):
        a = int(200 * (i / (h * 0.55)))
        y0 = int(h * 0.45) + i
        fd.line([(0, y0), (w, y0)], fill=(10, 10, 11, a))
    base.alpha_composite(fade)


def apply_grade(img: Image.Image, vignette: float, grain: float, t: float) -> Image.Image:
    if (vignette <= 0.01 and grain <= 0.01) or np is None:
        return img
    rgb = img.convert("RGB")
    arr = np.asarray(rgb).astype(np.float32)
    h, w = arr.shape[:2]
    if vignette > 0.01:
        yy = np.linspace(-1.0, 1.0, h, dtype=np.float32)[:, None]
        xx = np.linspace(-1.0, 1.0, w, dtype=np.float32)[None, :]
        r = np.sqrt(xx * xx + yy * yy)
        vig = 1.0 - float(vignette) * np.clip((r - 0.28) / 1.15, 0.0, 1.0) ** 1.35
        arr *= vig[..., None]
    if grain > 0.01:
        rng = np.random.default_rng(int(t * 24) & 0xFFFF)
        noise = rng.standard_normal((h, w)).astype(np.float32) * (grain * 16.0)
        arr += noise[..., None]
    out = Image.fromarray(np.clip(arr, 0, 255).astype(np.uint8), "RGB")
    if img.mode == "RGBA":
        a = img.getchannel("A")
        out = out.convert("RGBA")
        out.putalpha(a)
    return out


def draw_logo(img: Image.Image, logo: Image.Image | None) -> None:
    if logo is None:
        return
    w, h = img.size
    mark = logo.convert("RGBA")
    mw = max(48, int(w * 0.12))
    mh = int(mark.height * (mw / max(1, mark.width)))
    mark = mark.resize((mw, mh), Image.Resampling.LANCZOS)
    img.alpha_composite(mark, (w - mw - int(w * 0.05), h - mh - int(h * 0.08)))


def font(size: int, bold: bool = False) -> ImageFont.ImageFont:
    windir = os.environ.get("WINDIR", r"C:\Windows")
    candidates = [
        os.path.join(windir, "Fonts", "segoeuib.ttf" if bold else "segoeui.ttf"),
        os.path.join(windir, "Fonts", "arialbd.ttf" if bold else "arial.ttf"),
        "/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf" if bold else "/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf",
        "/usr/share/fonts/truetype/liberation/LiberationSans-Bold.ttf" if bold else "/usr/share/fonts/truetype/liberation/LiberationSans-Regular.ttf",
    ]
    for path in candidates:
        if os.path.isfile(path):
            return ImageFont.truetype(path, size)
    return ImageFont.load_default()


def draw_chrome(
    img: Image.Image,
    t: float,
    duration: float,
    theme: tuple[int, int, int],
    song: str,
    artist: str,
    album: str,
    show_titles: bool,
    show_progress: bool = True,
    title_scale: float = 1.0,
    title_pos: str = "Bottom",
) -> None:
    primary = theme
    w, h = img.size
    draw = ImageDraw.Draw(img, "RGBA")
    pad = int(w * 0.06)
    y = h - 36
    tw = w - pad * 2
    p = 0 if duration <= 0 else clamp(t / duration)
    if show_progress:
        draw.rounded_rectangle([pad, y, pad + tw, y + 4], radius=2, fill=(244, 240, 234, 40))
        draw.rounded_rectangle([pad, y, pad + max(4, int(tw * p)), y + 4], radius=2, fill=(*primary, 255))
        hx = pad + int(tw * p)
        draw.ellipse([hx - 5, y - 3, hx + 5, y + 7], fill=(244, 240, 234, 255))
    if not show_titles:
        return
    scale = (h / 1080) * max(0.5, min(1.8, title_scale))
    title_font = font(max(16, int(44 * scale)), bold=True)
    meta_font = font(max(11, int(20 * scale)), bold=False)
    song_s = (song or "").strip()
    meta = "  ·  ".join(x.upper() for x in (artist, album) if x.strip())
    top = title_pos.lower().startswith("top")
    ty = int(48 * scale + (h * 0.04 if top else 0)) if top else int(h - 130 * scale)
    my = ty + int(52 * scale)
    if song_s:
        draw.rectangle([pad, ty + int(8 * scale), pad + 6, ty + int(52 * scale)], fill=(*primary, 230))
        draw.text((pad + 22 * scale, ty), song_s.upper()[:48], font=title_font, fill=(244, 240, 234, 255))
        if meta:
            draw.text((pad + 22 * scale, my), meta[:64], font=meta_font, fill=(244, 240, 234, 160))
    tc = f"{int(t // 60)}:{int(t % 60):02d}  /  {int(duration // 60)}:{int(duration % 60):02d}"
    draw.text((w - pad - 160 * scale, y - 28), tc, font=meta_font, fill=(244, 240, 234, 140))


def render_frame(
    cover: Image.Image,
    analysis: dict,
    t: float,
    duration: float,
    style: str,
    theme: tuple[str, str, str],
    song: str,
    artist: str,
    album: str,
    bounce: float,
    show_titles: bool,
    zoom_state: list[float],
    engine: object | None = None,
    tilt: float = 42.0,
    vis_alpha: float = 0.72,
    size: tuple[int, int] | None = None,
    mode: str = "3D",
    place: dict | None = None,
    show_progress: bool = True,
    glow: float = 0.35,
    vignette: float = 0.55,
    grain: float = 0.1,
    title_scale: float = 1.0,
    logo: Image.Image | None = None,
    fade_in: float = 0.0,
    fade_out: float = 0.0,
    title_pos: str = "Bottom",
    pulse_hue: float = 0.0,
    preview: bool = False,
) -> Image.Image:
    pulse = float(analysis.get("pulse") or 0)
    if preview:
        glow = 0.0
        grain = 0.0
        vignette = min(float(vignette), 0.28)
    if pulse_hue > 1:
        deg = pulse_hue * (0.25 + pulse)
        theme = (hue_shift(theme[0], deg), hue_shift(theme[1], deg), theme[2] if len(theme) > 2 else theme[1])
    primary, secondary = hex_rgb(theme[0]), hex_rgb(theme[1] if len(theme) > 1 else theme[0])
    out_w, out_h = size or (W, H)
    place = place or {}
    if engine is not None and size is None:
        rgb = engine.render_rgb(analysis, style, theme, bounce, zoom_state, tilt, vis_alpha, t, place, mode)
        ow, oh = getattr(engine, "w", W), getattr(engine, "h", H)
        img = Image.frombytes("RGB", (ow, oh), rgb).convert("RGBA")
        img = apply_grade(img, vignette, grain, t)
        draw_chrome(img, t, duration, primary, song, artist, album, show_titles, show_progress, title_scale, title_pos)
        draw_logo(img, logo)
        img = img.convert("RGB")
        g = fade_gain(t, duration, fade_in, fade_out)
        if g < 0.999:
            img = Image.blend(Image.new("RGB", img.size, (10, 10, 11)), img, g)
        return img

    pulse = analysis["pulse"] * bounce
    target = 1.1 + pulse * 0.16 + analysis["bass"] * 0.04
    zoom_state[0] = lerp(zoom_state[0], target, 0.28)
    img = Image.new("RGBA", (out_w, out_h), (10, 10, 11, 255))
    cover_draw(img, cover.convert("RGBA"), zoom_state[0], pulse, out_w, out_h)
    try:
        from preview3d import draw_visualizer
    except ImportError:
        from desktop.preview3d import draw_visualizer  # type: ignore
    draw_visualizer(img, analysis, style, theme, tilt, vis_alpha, t, mode, place, glow)
    img = apply_grade(img, vignette, grain, t)
    draw_chrome(img, t, duration, primary, song, artist, album, show_titles, show_progress, title_scale, title_pos)
    draw_logo(img, logo)
    img = img.convert("RGB")
    g = fade_gain(t, duration, fade_in, fade_out)
    if g < 0.999:
        img = Image.blend(Image.new("RGB", img.size, (10, 10, 11)), img, g)
    return img


def theme_pair_from_look(look: dict) -> tuple[str, str, str]:
    theme = look.get("theme") or "Ice"
    preset = THEMES.get(theme, THEMES["Ice"])
    base = look.get("base") or preset[0]
    tip = look.get("tip") or preset[1]
    return (str(base), str(tip), str(tip))


def run_export(
    audio_path: str,
    dest: str,
    cover: Image.Image,
    look: dict,
    song: str = "",
    artist: str = "",
    album: str = "",
    logo: Image.Image | None = None,
    progress=None,
) -> str:
    """Encode an MP4. Returns the encoder label used."""
    if np is None:
        raise RuntimeError("Install python3-numpy to analyze audio.")
    if not ffmpeg_bin():
        raise RuntimeError("Install ffmpeg to decode audio and encode MP4.")
    look = merge_look(look)
    progress = progress or (lambda _msg, _pct: None)
    samples, sr = decode_audio(audio_path)
    duration = samples.size / sr
    analyzer = Analyzer(samples, sr)
    ow, oh = frame_wh(look["aspect"], look["res"])
    fps = int(look.get("fps") or 30)
    frames = max(1, int(duration * fps))
    theme = theme_pair_from_look(look)
    bounce = BOUNCE.get(look.get("bounce", "Medium"), 1.0)
    progress("Checking GPU encoder…", 0)
    software_v, hw, acodec = pick_ffmpeg_codecs()
    if hw:
        progress(hw["label"], 0)
        device = hw.get("device")
        if device and hw.get("kind") != "d3d":
            prime = dri_pci_prime(device)
            if prime:
                os.environ["DRI_PRIME"] = prime
            os.environ["LIBVA_DRM_DEVICE"] = device
            os.environ.setdefault("LIBVA_DRIVER_NAME", "radeonsi")
    elif ffmpeg_is_snap():
        progress("snap ffmpeg cannot use the GPU — using CPU", 0)
    else:
        progress("No hardware encoder — using CPU", 0)
    engine = None
    try:
        from engine3d import try_create
    except ImportError:
        try:
            from desktop.engine3d import try_create  # type: ignore
        except ImportError:
            try_create = None  # type: ignore
    if try_create is not None:
        progress(f"Starting GPU engine ({look['res']})…", 0)
        engine = try_create(ow, oh)
        if engine is not None:
            engine.set_cover(cover)
            gl = getattr(engine, "renderer", "") or ""
            if gl:
                progress(f"GL {gl}", 0)
    attempts: list[tuple[str, list[str], dict | None]] = []
    if hw:
        attempts.append(
            (
                hw["label"],
                build_ffmpeg_cmd(dest, audio_path, software_v, hw, acodec, ow, oh, fps),
                hw.get("env"),
            )
        )
    attempts.append(
        (
            "CPU",
            build_ffmpeg_cmd(dest, audio_path, software_v, None, acodec, ow, oh, fps),
            None,
        )
    )
    last_err = ""
    for idx, (label, cmd, env) in enumerate(attempts):
        progress(f"Rendering with {label}…", 0)
        rc, last_err = pipe_encode(
            cmd,
            frames,
            cover,
            analyzer,
            duration,
            theme,
            bounce,
            look,
            song,
            artist,
            album,
            engine,
            logo,
            fps,
            progress,
            env,
        )
        if rc == 0:
            return label
        if idx + 1 < len(attempts):
            hint = next((ln.strip() for ln in last_err.splitlines() if ln.strip()), "ffmpeg error")
            _write_vaapi_log(
                f"export using {label} failed\ncmd: {' '.join(cmd)}\n\n{last_err}"
            )
            progress(f"GPU failed ({hint[:90]}), using CPU…", 0)
    detail = last_err.strip() or "ffmpeg failed to encode the video"
    raise RuntimeError(detail[-800:])


def pipe_encode(
    cmd: list[str],
    frames: int,
    cover: Image.Image,
    analyzer: Analyzer,
    duration: float,
    theme: tuple[str, str, str],
    bounce: float,
    look: dict,
    song: str,
    artist: str,
    album: str,
    engine: object | None,
    logo: Image.Image | None,
    fps: int,
    progress,
    env: dict | None = None,
) -> tuple[int, str]:
    err_file = tempfile.NamedTemporaryFile(prefix="renderbolt-ffmpeg-", suffix=".log", delete=False)
    err_path = err_file.name
    err_file.close()
    proc: subprocess.Popen[bytes] | None = None
    log = ""
    try:
        with open(err_path, "wb") as err:
            proc = subprocess.Popen(
                cmd,
                stdin=subprocess.PIPE,
                stderr=err,
                env=env,
                **_popen_kw(),
            )
            assert proc.stdin is not None
            dt = 1 / max(1, fps)
            zoom_state = [1.12]
            place = look.get("place") or {}
            out_size = None if engine is not None else frame_wh(look["aspect"], look["res"])
            for i in range(frames):
                t = i * dt
                frame = render_frame(
                    cover,
                    analyzer.at(t, dt, float(look.get("sens", 1))),
                    t,
                    duration,
                    look.get("style", "Waveform"),
                    theme,
                    song,
                    artist,
                    album,
                    bounce,
                    bool(look.get("show_titles", True)),
                    zoom_state,
                    engine,
                    float(look.get("tilt", 42)),
                    float(look.get("alpha", 0.78)),
                    out_size,
                    look.get("mode", "3D"),
                    place,
                    bool(look.get("show_progress", True)),
                    float(look.get("glow", 0.4)),
                    float(look.get("vignette", 0.55)),
                    float(look.get("grain", 0.1)),
                    float(look.get("title_scale", 1)),
                    logo,
                    float(look.get("fade_in", 0.6)),
                    float(look.get("fade_out", 1.2)),
                    look.get("title_pos", "Bottom"),
                    float(look.get("pulse_hue", 0)),
                )
                proc.stdin.write(frame.tobytes())
                if i % 10 == 0:
                    progress(f"Rendering {i}/{frames}", 100 * i / frames)
            proc.stdin.close()
            rc = proc.wait()
    except BrokenPipeError:
        if proc is not None:
            proc.wait()
        rc = proc.returncode if proc is not None and proc.returncode else 1
    except Exception:
        if proc is not None and proc.poll() is None:
            proc.kill()
            proc.wait()
        raise
    finally:
        try:
            log = Path(err_path).read_text(errors="replace")
        except OSError:
            log = ""
        try:
            os.unlink(err_path)
        except OSError:
            pass
    return rc, log


